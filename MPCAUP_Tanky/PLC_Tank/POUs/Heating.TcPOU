<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="Heating" Id="{67bfd793-3f9c-4f6b-ac3b-8ac7d5e1f5d7}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Heating
VAR_INPUT
	diEnabled : BOOL;
	iSecImp : BOOL;
END_VAR
VAR_OUTPUT
	doEnabled : BOOL;
END_VAR
VAR_IN_OUT
	HeatingPhase : TPhaseHeating;
	Heater : THeater;
END_VAR
VAR
	//pidParameters : ST_CTRL_PID_PARAMS;   // unused - PID is in Heater
	rtSecImp : R_TRIG;          // rising edge of second impulse
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[{region "Aut/Man"}
    // switching state of phase - automatic or manual control (default state is manual)
    // if both commands come at once, manual has priority (safety)
    IF HeatingPhase.Cmd.ManCtrl THEN
        HeatingPhase.State.ManCtrl := TRUE;
        HeatingPhase.State.AutCtrl := FALSE;
    ELSIF HeatingPhase.Cmd.AutCtrl THEN
        HeatingPhase.State.ManCtrl := FALSE;
        HeatingPhase.State.AutCtrl := TRUE;
    END_IF;

    // initialization - if neither mode is active, use manual
    IF NOT HeatingPhase.State.AutCtrl AND NOT HeatingPhase.State.ManCtrl THEN
        HeatingPhase.State.ManCtrl := TRUE;
    END_IF;

    // commands are always reset after processing
    HeatingPhase.Cmd.ManCtrl := FALSE;
    HeatingPhase.Cmd.AutCtrl := FALSE;
{endregion}

{region "ManCtrl"}
    // processing manual actions - if command is processed, it is set to FALSE even if can't be processed
    // Phase commands are start, stop, pause and resume
    // Start  - start heating
    // Stop   - stop heating
    // Pause  - stop heating (remaining condition is evaluated again after resume)
    // Resume - start heating
    // real states of phase are written into states in phase structure
    IF HeatingPhase.State.ManCtrl THEN
        IF HeatingPhase.State.Idle AND HeatingPhase.Cmd.StartMan THEN
            HeatingPhase.State.Running := TRUE;
            HeatingPhase.State.Idle := FALSE;
            HeatingPhase.State.Paused := FALSE;
            HeatingPhase.State.Done := FALSE;
        ELSIF HeatingPhase.Cmd.StopMan THEN
            HeatingPhase.State.Running := FALSE;
            HeatingPhase.State.Idle := TRUE;
            HeatingPhase.State.Paused := FALSE;
        ELSIF HeatingPhase.State.Running AND HeatingPhase.Cmd.PauseMan THEN
            HeatingPhase.State.Running := FALSE;
            HeatingPhase.State.Idle := FALSE;
            HeatingPhase.State.Paused := TRUE;
        ELSIF HeatingPhase.State.Paused AND HeatingPhase.Cmd.ResumeMan THEN
            HeatingPhase.State.Running := TRUE;
            HeatingPhase.State.Idle := FALSE;
            HeatingPhase.State.Paused := FALSE;
            HeatingPhase.State.Done := FALSE;
        END_IF;
    END_IF;

    HeatingPhase.Cmd.StartMan := FALSE;
    HeatingPhase.Cmd.StopMan := FALSE;
    HeatingPhase.Cmd.PauseMan := FALSE;
    HeatingPhase.Cmd.ResumeMan := FALSE;
{endregion}

{region "AutCtrl"}
    // if phase is in automatic mode, process StartAut / StopAut (from MES)
    // commands are set to FALSE after their processing
    IF HeatingPhase.State.AutCtrl THEN
        IF HeatingPhase.State.Idle AND HeatingPhase.Cmd.StartAut THEN
            HeatingPhase.State.Running := TRUE;
            HeatingPhase.State.Idle := FALSE;
            HeatingPhase.State.Done := FALSE;
        ELSIF HeatingPhase.Cmd.StopAut THEN
            HeatingPhase.State.Running := FALSE;
            HeatingPhase.State.Idle := TRUE;
            HeatingPhase.State.Paused := FALSE;
        END_IF;
    END_IF;

    HeatingPhase.Cmd.StartAut := FALSE;
    HeatingPhase.Cmd.StopAut := FALSE;
{endregion}

{region "Done"}
    // every phase should have finish condition - heating phase - water temp must stay
    // within +-1 °C of requested value for 10 seconds (skripta 10.3.11)
    // fTime counts seconds in tolerance band; it is reset when temp leaves the band or phase is not running
    rtSecImp(CLK := iSecImp);   // must be called every cycle, otherwise edges are lost

    IF HeatingPhase.State.Running THEN
        IF ABS(HeatingPhase.WaterTemp - HeatingPhase.ParamReqTemp) <= 1.0 THEN
            IF rtSecImp.Q THEN
                HeatingPhase.fTime := HeatingPhase.fTime + 1;
            END_IF;
        ELSE
            HeatingPhase.fTime := 0;
        END_IF;
    ELSE
        HeatingPhase.fTime := 0;
    END_IF;

    // finish condition met -> stop phase (processed next cycle) and signal Done
    IF HeatingPhase.State.Running AND (HeatingPhase.fTime >= 10) THEN
        HeatingPhase.Cmd.StopMan := TRUE;
        HeatingPhase.Cmd.StopAut := TRUE;
        HeatingPhase.State.Done := TRUE;
    END_IF;

    // command reset done resets done state and then resets command
    IF HeatingPhase.Cmd.ResetDone THEN
        HeatingPhase.State.Done := FALSE;
        HeatingPhase.Cmd.ResetDone := FALSE;
    END_IF;
{endregion}

{region "States"}
    // Command heater in cases of states
    // Running - start heating, pass requested temperature to heater (PID setpoint)
    // Idle    - stop heating
    // Paused  - stop heating (alternative would be holding actual temperature)
    IF HeatingPhase.State.Running THEN
        Heater.ParamHeatingSetPointAutomat := HeatingPhase.ParamReqTemp;
        Heater.Cmd.Req2RunAutCtrl := TRUE;
    ELSE
        Heater.Cmd.Req2RunAutCtrl := FALSE;
    END_IF;
{endregion}

// default state of phase - if not any state sets state to idle
IF NOT HeatingPhase.State.Idle AND NOT HeatingPhase.State.Paused AND NOT HeatingPhase.State.Running THEN
    HeatingPhase.State.Idle := 1;
END_IF;

// write binary states into int value for visualization
IF HeatingPhase.State.Idle THEN
    HeatingPhase.State.Stateint := Global.PhIdle;
ELSIF HeatingPhase.State.Running THEN
    HeatingPhase.State.Stateint := Global.PhRunning;
ELSE
    HeatingPhase.State.Stateint := Global.PhPause;
END_IF;

doEnabled := diEnabled;]]></ST>
    </Implementation>
    <LineIds Name="Heating">
      <LineId Id="72" Count="1" />
      <LineId Id="86" Count="6" />
      <LineId Id="122" Count="5" />
      <LineId Id="141" Count="5" />
      <LineId Id="224" Count="0" />
      <LineId Id="275" Count="2" />
      <LineId Id="170" Count="7" />
      <LineId Id="183" Count="3" />
      <LineId Id="281" Count="1" />
      <LineId Id="189" Count="0" />
      <LineId Id="204" Count="0" />
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>